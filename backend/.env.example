# Server
PORT=4000
# The site (frontend/) is served by this same server at http://localhost:4000,
# so no CORS setting is needed. Only set this if you host the frontend on a
# different origin.
# FRONTEND_ORIGIN=https://some-other-origin.example

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/cutout_website

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the customer back. Optional: these are the defaults
# (built from PUBLIC_API_URL below).
STRIPE_SUCCESS_URL=http://localhost:4000/order-status?order={ORDER_ID}
STRIPE_CANCEL_URL=http://localhost:4000/checkout

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cutout-website-uploads

# Email (SES) — fulfillment address that forwards orders to the supplier
FULFILLMENT_EMAIL=orders@yourdomain.com
SES_FROM_EMAIL=no-reply@yourdomain.com

# Uploaded images. "disk" needs no AWS and is the default for local dev;
# use "s3" in production (S3_BUCKET + AWS_* above).
STORAGE_DRIVER=disk
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=25
UPLOAD_MIN_LONG_EDGE_PX=2000

# Expiring image download links (fulfillment email + admin page).
# PUBLIC_API_URL is the site's public address (site and API share it); it's
# used for download links in emails and the default Stripe return URLs.
# FILE_LINK_SECRET and ADMIN_TOKEN: 32+ random characters each, generated
# with `openssl rand -base64 48`.
PUBLIC_API_URL=http://localhost:4000
FILE_LINK_SECRET=dev-only-change-me
DOWNLOAD_LINK_TTL_DAYS=30

# Shared secret for /api/admin/* (entered once per browser tab on
# admin.html, sent only in the X-Admin-Token header). The server refuses to
# start in production while this or FILE_LINK_SECRET is missing, still the
# dev value, or shorter than 32 characters.
ADMIN_TOKEN=dev-admin-token

# Production network setup (Caddy terminates HTTPS in front of this app).
# HOST=127.0.0.1 keeps port 4000 reachable only through Caddy.
# TRUST_PROXY says which proxy may report the client's real IP/protocol;
# "loopback" fits Caddy on the same machine.
HOST=0.0.0.0
TRUST_PROXY=loopback
