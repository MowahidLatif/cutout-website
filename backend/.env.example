# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5500

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/cutout_website

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5500/order-status.html?order={ORDER_ID}
STRIPE_CANCEL_URL=http://localhost:5500/create.html

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cutout-website-uploads

# Email (SES) — fulfillment address that forwards orders to the supplier
FULFILLMENT_EMAIL=orders@yourdomain.com
SES_FROM_EMAIL=no-reply@yourdomain.com
