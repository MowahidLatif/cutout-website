# Server
PORT=4000
# The site (frontend/) is served by this same server at http://localhost:4000,
# so no CORS setting is needed. Only set this if you host the frontend on a
# different origin.
# FRONTEND_ORIGIN=https://some-other-origin.example

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/cutout_website

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the customer back. Optional: these are the defaults
# (built from SITE_URL below).
STRIPE_SUCCESS_URL=http://localhost:4000/order-status?order={ORDER_ID}
STRIPE_CANCEL_URL=http://localhost:4000/checkout

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cutout-website-uploads

# Email (SES) — fulfillment address that forwards orders to the supplier.
# Required in production (the server refuses to start without it).
FULFILLMENT_EMAIL=orders@yourdomain.com
SES_FROM_EMAIL=no-reply@yourdomain.com

# Uploaded images. "disk" needs no AWS and is the default for local dev;
# use "s3" in production (S3_BUCKET + AWS_* above).
STORAGE_DRIVER=disk
UPLOAD_DIR=./storage/uploads
# 18 MB = the most a file can be and still be emailed (mailboxes cap whole
# messages at 20–25 MB; attachments grow ~33% when encoded). The stored print
# file is kept under this too.
UPLOAD_MAX_MB=18
# There's no minimum photo resolution: any photo or PDF is accepted and the
# studio shows its print quality (low quality needs the customer's OK).

# SITE_URL is the site's public address (site and API share it). It's used
# for every link we send: order-status and image links in emails, and the
# default Stripe return URLs. In production it must be https:// (the server
# refuses to start otherwise). PUBLIC_API_URL, its old name, still works.
# FILE_LINK_SECRET and ADMIN_TOKEN: 32+ random characters each, generated
# with `openssl rand -base64 48`.
SITE_URL=http://localhost:4000
FILE_LINK_SECRET=dev-only-change-me
DOWNLOAD_LINK_TTL_DAYS=30

# Shared secret for /api/admin/* (entered once per browser tab on
# admin.html, sent only as `Authorization: Bearer <token>`). The server refuses to
# start in production while this or FILE_LINK_SECRET is missing, still the
# dev value, or shorter than 32 characters.
ADMIN_TOKEN=dev-admin-token

# Production network setup (Caddy terminates HTTPS in front of this app).
# HOST=127.0.0.1 keeps port 4000 reachable only through Caddy.
HOST=0.0.0.0
# TRUST_PROXY = how many proxies are in front of the app: 0 locally, 1 behind
# Caddy. It decides which IP the rate limits and audit log see.
TRUST_PROXY=0
# Only if Cloudflare (or similar) is in front: read the client IP from its
# header. Leave unset otherwise — anyone could fake it.
# CLIENT_IP_HEADER=cf-connecting-ip

# Tests only (`npm test`): a SEPARATE database whose name ends in _test. Put it
# in backend/.env.test (git-ignored) or the environment. Unset → in-memory DB.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/cutout_website_test
