# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5500

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/cutout_website

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5500/order-status.html?order={ORDER_ID}
STRIPE_CANCEL_URL=http://localhost:5500/create.html

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cutout-website-uploads

# Email (SES) — fulfillment address that forwards orders to the supplier
FULFILLMENT_EMAIL=orders@yourdomain.com
SES_FROM_EMAIL=no-reply@yourdomain.com

# Uploaded images. "disk" needs no AWS and is the default for local dev;
# use "s3" in production (S3_BUCKET + AWS_* above).
STORAGE_DRIVER=disk
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=25
UPLOAD_MIN_LONG_EDGE_PX=2000

# Expiring image download links (fulfillment email + admin page).
# PUBLIC_API_URL is where the supplier's browser can reach this backend.
PUBLIC_API_URL=http://localhost:4000
FILE_LINK_SECRET=dev-only-change-me
DOWNLOAD_LINK_TTL_DAYS=30

# Shared secret for /api/admin/* (entered once on admin.html).
# The server refuses to start in production while this or FILE_LINK_SECRET
# is still the dev value.
ADMIN_TOKEN=dev-admin-token
